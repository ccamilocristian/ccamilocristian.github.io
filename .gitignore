*.pyc

# --- Secrets / credentials (safety net — must NEVER be committed) ---
.env
.env.*
*.pem
*.key
mcp.json
**/mcp.json
*google_creds*
*service_account*.json
*client_secret*.json
credentials*.json
token*.json
oauth-tokens.json
**/oauth-tokens.json
.secrets/

# gsccli — keep only optional public `.gsccli.json` (site URL). Never commit home config.
.gsccli/
**/.gsccli/

# yui-compressor
*.jar

# OS / editor noise
.DS_Store
*.swp
*.swo
*~

# Keep Cursor project rules in git
!.cursorrules
!.cursor/
!.cursor/rules/
!.cursor/rules/**
