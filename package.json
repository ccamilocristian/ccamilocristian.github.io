{
  "name": "ccamilocristian-github-io",
  "private": true,
  "description": "Tooling for site-wide Lighthouse SEO scans (Unlighthouse). Jekyll remains the site builder.",
  "scripts": {
    "seo:unlighthouse": "unlighthouse --site https://ccamilocristian.github.io",
